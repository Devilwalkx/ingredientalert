{
  "expo": {
    "name": "IngredientAlert (synthetic demo)",
    "slug": "ingredientalert",
    "version": "0.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": { "bundleIdentifier": "invalid.placeholder.ingredientalert" },
    "android": {
      "package": "invalid.placeholder.ingredientalert",
      "permissions": [],
      "blockedPermissions": [
        "CAMERA", "RECORD_AUDIO", "ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "ACCESS_BACKGROUND_LOCATION",
        "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE", "READ_MEDIA_IMAGES", "READ_MEDIA_VIDEO"
      ]
    },
    "plugins": ["expo-secure-store"],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "IngredientAlert (synthetic demo)",
      "shortName": "IngredientAlert",
      "backgroundColor": "#ffffff",
      "themeColor": "#8a2a00",
      "lang": "en-GB"
    },
    "platforms": ["ios", "android", "web"]
  }
}
