{
  "expo": {
    "name": "IngredientAlert",
    "slug": "ingredientalert",
    "version": "0.2.0",
    "orientation": "default",
    "ios": {
      "bundleIdentifier": "app.devilwalkx.ingredientalert"
    },
    "android": {
      "package": "app.devilwalkx.ingredientalert",
      "permissions": [],
      "blockedPermissions": [
        "RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "SYSTEM_ALERT_WINDOW",
        "VIBRATE",
        "INTERNET",
        "POST_NOTIFICATIONS",
        "ACCESS_NETWORK_STATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./public/icon-maskable-512.png",
        "backgroundColor": "#1B5E43"
      },
      "predictiveBackGestureEnabled": true,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "IngredientAlert uses the camera only to read the barcode on a delivery pack. Pictures are not saved or sent anywhere.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "IngredientAlert",
      "shortName": "IngredientAlert",
      "backgroundColor": "#F4F7F2",
      "themeColor": "#1B5E43",
      "lang": "en-GB"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./public/icon-512.png",
    "userInterfaceStyle": "automatic"
  }
}
